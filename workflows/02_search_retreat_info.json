    {
      "parameters": {
        "jsCode": "const points = $input.first().json?.result ?? [];\n\nif (points.length === 0) {\n  return [{ json: { output: 'Информация не найдена.', source: 'Неизвестно' } }];\n}\n\nconst humanNames = {\n  '01_brand_overview.md': 'О ретрите',\n  '04_retreat_concept.md': 'Концепция ретрита',\n  '12_program_overview.md': 'Программа ретрита',\n  '13_daily_schedule.md': 'Расписание дня',\n  '14_practices_methods.md': 'Практики и методы',\n  '17_community.md': 'Сообщество',\n  '19_post_retreat_integration.md': 'Постретритная интеграция',\n  '23_postretrit_integraciya.md': 'Жизнь после ретрита',\n};\n\nconst text = points\n  .map(p => p.payload?.content ?? '')\n  .filter(t => t.length > 0)\n  .join('\\n\\n');\n\nconst sources = [...new Set(\n  points\n    .map(p => humanNames[p.payload?.metadata?.source] ?? p.payload?.metadata?.source ?? '')\n    .filter(s => s.length > 0)\n)];\n\nreturn [{ json: {\n  output: text,\n  source: sources.join(', ')\n} }];"
