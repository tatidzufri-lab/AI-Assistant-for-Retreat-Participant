    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst result = [];\n\n// Все триггерные точки сценария\nconst triggerDays = [3, 0, -2, -7, -30];\n\nfor (const item of rows) {\n  const rawStart = item.json['Дата_ретрита'];\n  const rawEnd   = item.json['Дата_окончания'];\n  if (!rawStart) continue;\n\n  // Парсим Дата_ретрита (DD.MM.YYYY)\n  let retreatStart;\n  if (rawStart.includes('.')) {\n    const [d, m, y] = rawStart.split('.');\n    retreatStart = new Date(Number(y), Number(m) - 1, Number(d));\n  } else {\n    retreatStart = new Date(rawStart);\n  }\n  retreatStart.setHours(0, 0, 0, 0);\n  if (isNaN(retreatStart.getTime())) continue;\n\n  // Парсим Дата_окончания (DD.MM.YYYY)\n  let retreatEnd = null;\n  if (rawEnd && rawEnd.includes('.')) {\n    const [d, m, y] = rawEnd.split('.');\n    retreatEnd = new Date(Number(y), Number(m) - 1, Number(d));\n    retreatEnd.setHours(0, 0, 0, 0);\n    if (isNaN(retreatEnd.getTime())) retreatEnd = null;\n  }\n\n  // diffDays: до старта считаем от Дата_ретрита, после — от Дата_окончания\n  const diffFromStart = Math.round((retreatStart - today) / (1000 * 60 * 60 * 24));\n  const diffFromEnd   = retreatEnd\n    ? Math.round((today - retreatEnd) / (1000 * 60 * 60 * 24))\n    : null;\n\n  // Определяем активный diffDays для маршрутизации\n  let activeDiff = null;\n\n  if (diffFromStart === 3)  activeDiff = 3;   // за 3 дня\n  if (diffFromStart === 0)  activeDiff = 0;   // день старта\n  if (diffFromEnd   === 2)  activeDiff = -2;  // через 2 дня после\n  if (diffFromEnd   === 7)  activeDiff = -7;  // через 7 дней после\n  if (diffFromEnd   === 30) activeDiff = -30; // через 30 дней после\n\n  if (activeDiff === null) continue;\n\n  result.push({\n    json: {\n      ...item.json,\n      diffDays: String(activeDiff),\n      telegramId: String(item.json['Telegram_ID'])\n    }\n  });\n}\n\nreturn result;\n"
      },
