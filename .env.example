# Домен и публичный адрес n8n. Для локального запуска можно оставить как есть,
# но Telegram Trigger требует https-адрес, доступный из интернета.
N8N_DOMAIN=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678/

# Ключ шифрования учетных данных n8n. Сгенерировать один раз и не менять:
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Ключ доступа к Qdrant, тот же указывается в учетных данных Qdrant в n8n
QDRANT_API_KEY=

# Telegram ID организатора: сюда приходят уведомления о тревожных сообщениях
CURATOR_CHAT_ID=
